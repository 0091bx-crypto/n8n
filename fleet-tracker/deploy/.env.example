# Copy this file to .env and fill in your values.

# The public domain that points to this server (an A record in your DNS).
DOMAIN=n8n.example.com

# Email for the Let's Encrypt certificate. Use a real inbox you check.
[email protected]

# Server time zone, e.g. Europe/Berlin, America/New_York, Asia/Kolkata.
TZ=UTC

# A long random secret. Generate one with:  openssl rand -hex 24
# Keep it safe and never change it after the first start.
N8N_ENCRYPTION_KEY=change-me
